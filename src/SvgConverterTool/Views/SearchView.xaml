<UserControl x:Class="SvgConverterTool.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- 格式按钮：圆角小标签 -->
        <Style x:Key="FormatChipStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.65"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 圆角输入框：搜索框等普通输入 -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5D9E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Foreground="#B3B8C2"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B9C2CE"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆角下拉框：白底细边框、自绘箭头、圆角弹出列表 -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5D9E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Background="Transparent" CornerRadius="4"
                                            Margin="3,1" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#EDF4FE"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#E3EEFD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                             Background="Transparent" BorderThickness="0"
                                             Margin="{TemplateBinding Padding}"
                                             FontSize="{TemplateBinding FontSize}"
                                             Foreground="{TemplateBinding Foreground}"
                                             VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden"
                                             VerticalScrollBarVisibility="Hidden"
                                             Visibility="Collapsed"/>
                                    <ToggleButton x:Name="ToggleButton" Grid.Column="1"
                                                  Focusable="False" ClickMode="Press"
                                                  Background="Transparent" BorderThickness="0"
                                                  Cursor="Hand"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="28">
                                                    <Path Data="M0,0 L4,4 L8,0" Stroke="#9AA0A8"
                                                          StrokeThickness="1.4"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0" Background="White"
                                        BorderBrush="#E3E6EB" BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="0,3">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B9C2CE"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行内可编辑的描述框：平时像普通文本，获得焦点才显示边框 -->
        <Style x:Key="RowDescriptionStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="ToolTip" Value="填写这个图标的用途，失焦自动保存"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#90CAF9"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#222"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 行内重命名输入框 -->
        <Style x:Key="RowRenameBoxStyle" TargetType="TextBox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表头：扁平、无拖拽手柄 -->
        <Style x:Key="ColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#F7F8FA" BorderBrush="#ECEDF0" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行：悬停高亮、选中浅蓝、细分割线 -->
        <Style x:Key="RowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder" Background="Transparent"
                                BorderBrush="#F2F3F5" BorderThickness="0,0,0,1"
                                Padding="0,7">
                            <GridViewRowPresenter
                                Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="RowBorder" Property="Background" Value="#FCFCFD"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F5F9FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#EAF2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox x:Name="TxtSearch" Style="{StaticResource RoundedTextBoxStyle}"
                             Width="260" Height="32"
                             Tag="搜索名称、分组或描述"
                             TextChanged="TxtSearch_TextChanged"/>
                    <ComboBox x:Name="CmbGroup" Style="{StaticResource RoundedComboBoxStyle}"
                              Width="180" Height="32" Margin="8,0,0,0"
                              ToolTip="按分组筛选"
                              SelectionChanged="CmbGroup_SelectionChanged"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" Grid.Column="2" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontSize="13" Foreground="#666"/>
            </Grid>
        </Border>

        <!-- 提示信息 -->
        <Border Grid.Row="1" Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="0,0,0,1" Padding="10">
            <TextBlock Text="💡 搜索图标名称、分组或描述；点击名称可重命名，点击分组标签可移动分组，点击描述可填写用途"
                       Foreground="#E65100" FontSize="12"/>
        </Border>

        <!-- 结果列表：每行一个图标，ListView 自带行虚拟化 -->
        <Border Grid.Row="2" Margin="10" Background="White"
                BorderBrush="#E6E7EB" BorderThickness="1" CornerRadius="8">
            <ListView x:Name="ListResults"
                      BorderThickness="0" Background="Transparent"
                      AlternationCount="2"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ItemContainerStyle="{StaticResource RowStyle}"
                      SizeChanged="ListResults_SizeChanged">
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}"/>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="图标" Width="84">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="44" Height="44" Background="#FAFAFA" BorderBrush="#F0F0F0"
                                            BorderThickness="1" CornerRadius="7" Margin="8,0">
                                        <Image Source="{Binding PreviewImage}" Width="34" Height="34" Stretch="Uniform"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 分组标签在上、名称在下 -->
                        <GridViewColumn Header="分组 / 名称" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,0">
                                        <Grid HorizontalAlignment="Left" MaxWidth="170" Margin="0,0,0,4">
                                            <Border x:Name="GroupTag" Background="#E4E7EC" CornerRadius="4" Padding="6,1"
                                                    Cursor="Hand"
                                                    ToolTip="点击修改分组，回车确认"
                                                    MouseLeftButtonUp="GroupTag_MouseLeftButtonUp">
                                                <TextBlock FontSize="10.5" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Group}"/>
                                                            <Setter Property="Foreground" Value="#4B5563"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Group}" Value="">
                                                                    <Setter Property="Text" Value="默认分组"/>
                                                                    <Setter Property="Foreground" Value="#8A919C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <ComboBox x:Name="CmbGroupEdit" Visibility="Collapsed"
                                                      Style="{StaticResource RoundedComboBoxStyle}"
                                                      Width="150" Height="26" FontSize="11.5"
                                                      Padding="6,0" IsEditable="True" MaxDropDownHeight="240"
                                                      BorderBrush="#90CAF9" BorderThickness="1"
                                                      ItemsSource="{Binding GroupChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      KeyDown="GroupBox_KeyDown"
                                                      LostFocus="GroupBox_LostFocus"/>
                                        </Grid>

                                        <Grid>
                                            <TextBlock Text="{Binding FileName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#333"
                                                       Cursor="IBeam"
                                                       ToolTip="点击重命名"
                                                       MouseLeftButtonUp="FileName_MouseLeftButtonUp"/>
                                            <TextBox x:Name="TxtRename"
                                                     Style="{StaticResource RowRenameBoxStyle}"
                                                     KeyDown="RenameBox_KeyDown"
                                                     LostFocus="RenameBox_LostFocus"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 格式：2×2 标签 -->
                        <GridViewColumn Header="格式" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,0" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Content="XAML"
                                                Style="{StaticResource FormatChipStyle}" Margin="0"
                                                Background="#D3E4FD" Foreground="#1A5FCB"
                                                Tag="{Binding XamlPath}" IsEnabled="{Binding HasXaml}"
                                                ToolTip="复制 XAML 文本" Click="BtnCopyFormat_Click"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="SVG"
                                                Style="{StaticResource FormatChipStyle}" Margin="5,0,0,0"
                                                Background="#FFDFC4" Foreground="#C85F1F"
                                                Tag="{Binding SvgPath}" IsEnabled="{Binding HasSvg}"
                                                ToolTip="复制 SVG 文件" Click="BtnCopyFormat_Click"/>
                                        <Button Grid.Row="1" Grid.Column="0" Content="PNG"
                                                Style="{StaticResource FormatChipStyle}" Margin="0,5,0,0"
                                                Background="#D3EFD9" Foreground="#24803F"
                                                Tag="{Binding PngPath}" IsEnabled="{Binding HasPng}"
                                                ToolTip="复制 PNG 图片" Click="BtnCopyFormat_Click"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="ICO"
                                                Style="{StaticResource FormatChipStyle}" Margin="5,5,0,0"
                                                Background="#E6D8F9" Foreground="#6A3EB0"
                                                Tag="{Binding IcoPath}" IsEnabled="{Binding HasIco}"
                                                ToolTip="复制 ICO 文件" Click="BtnCopyFormat_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 描述 -->
                        <GridViewColumn x:Name="DetailColumn" Header="描述" Width="340">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,0">
                                        <TextBlock Text="填写这个图标的用途…"
                                                   FontSize="12" Foreground="#C6C8CC"
                                                   VerticalAlignment="Center" Margin="7,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Description}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource RowDescriptionStyle}"
                                                 VerticalAlignment="Center"
                                                 LostFocus="DescriptionBox_LostFocus"
                                                 KeyDown="DescriptionBox_KeyDown"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
